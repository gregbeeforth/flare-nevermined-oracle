{
  "name": "flare-nevermined-oracle",
  "version": "1.0.0",
  "description": "Verifiable Flare Oracle Feed on Nevermined - stateless FTSO data service with time-bound JWT access",
  "type": "module",
  "main": "src/worker.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "jest --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "jest --testPathPattern=server.integration",
    "publish-asset": "tsx scripts/publishAsset.ts",
    "lint": "eslint src/**/*.ts scripts/**/*.ts",
    "clean": "rm -rf dist node_modules .wrangler"
  },
  "keywords": [
    "flare",
    "ftso",
    "oracle",
    "nevermined",
    "payments",
    "data-feed",
    "jwt"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@nevermined-io/payments": "^1.10.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.4",
    "hono": "^4.13.1",
    "jose": "^5.10.0",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.4",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.2",
    "wrangler": "^4.120.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/greg-hub/flare-nevermined-oracle.git"
  }
}
